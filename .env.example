GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
# Shared by both providers — they land on the same callback route
OAUTH_REDIRECT_URI=http://localhost:5173/api/auth/callback
PUBLIC_SPACETIMEDB_MODULE=
PUBLIC_SPACETIMEDB_URI=wss://maincloud.spacetimedb.com
API_KEYS=sk-agent-your-key-here
